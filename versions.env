# The FFmpeg release every platform builds. Linux and Windows build its
# release branch at FFMPEG_COMMIT, past the release by fixes only: BtbN's
# images carry codec libraries newer than the release tag compiles against.
FFMPEG=9.0.2
FFMPEG_COMMIT=d4070a14cecc7e29eb278f9b6036c2284255f70d

# BtbN/FFmpeg-Builds builds Linux and Windows, cross-compiling in Docker images
# that carry every codec library already built. The script and each image are
# pinned: the images' `latest` tags move daily.
BTBN_COMMIT=c9fe5114060e507409f7ee07edfd82efaf25d767
IMAGE_linux64=sha256:b17ebd1464e9df741e71f514045f9dbe349e2b3875c36ab21474d2b006f5674a
IMAGE_linuxarm64=sha256:c628bb9d6eb1aa53c1de9906054d64f9761f1cefa78cf62207f0d72c409f0553
IMAGE_win64=sha256:49e23d45202a3399249129ebeb42bc2afd91de642e8d9cea27de43b3ac9051d7
IMAGE_winarm64=sha256:7d3f8b60b1589a32182bcdb67d1fe77003fe0c11f631dfb245da08848f64dd72

# markus-perl/ffmpeg-build-script builds macOS from source, each library's
# tarball pinned by sha256 in its src/10-versions.sh.
BUILD_SCRIPT_COMMIT=911ff7b385567b8a7ac69daa9ff22c7e36dad8b1

# Libraries left out because another in the build does the same job, so no
# format is lost: rav1e and libaom (SVT-AV1 encodes AV1, dav1d decodes it) and
# openh264 (x264 encodes H.264, FFmpeg decodes it). macOS also leaves out
# Vulkan and libplacebo, which need a Vulkan driver Macs do not have.
OMIT_CONFIGURE="--disable-libaom --disable-librav1e --disable-libopenh264"
OMIT_MACOS=rav1e,av1,openh264,vulkan
